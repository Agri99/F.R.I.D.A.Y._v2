# SearXNG Environment - Official Template
# Source: https://raw.githubusercontent.com/searxng/searxng/master/container/.env.example

# SearXNG version
SEARXNG_VERSION=latest

# Network binding - localhost only for security
SEARXNG_HOST=127.0.0.1
SEARXNG_PORT=8080

# Optional: Public base URL (e.g., https://search.example.com)
# Leave empty for local development
SEARXNG_BASE_URL=

# Secret key for session signing - GENERATE A NEW ONE
# python -c "import secrets; print(secrets.token_hex(32))"
SEARXNG_SECRET=changeme_generate_a_new_secret

# Rate limiter (disabled for local FRIDAY use)
SEARXNG_LIMITER=false

# Image proxy
SEARXNG_IMAGE_PROXY=true