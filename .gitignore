# F.R.I.D.A.Y. v2 — Git Ignore

# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl

# ── Virtual environments ────────────────────────────────────────
.venv/
venv/
ENV/

# ── IDE ─────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Secrets & credentials (NEVER commit) ────────────────────────
.env
secrets/
*.pem
*.key
token.json

# ── Audio recordings (transient) ────────────────────────────────
audio.wav
*.wav
!models/**/*.wav

# ── Runtime data ────────────────────────────────────────────────
data/
workspace/
audit_log.jsonl
conversation_history.json

# ── Legacy files (will be removed) ──────────────────────────────
_stale_delete_me/

# ── OS artifacts ────────────────────────────────────────────────
Thumbs.db
.DS_Store

# ── Pytest ──────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Model weights (too large for git) ───────────────────────────
models/*.onnx
models/*.ckpt
models/spkrec-ecapa-voxceleb/

# ── Developing related files ────────────────────────────────────
FRIDAY_v2_System_Architecture_Blueprint.md
Update_Log.txt