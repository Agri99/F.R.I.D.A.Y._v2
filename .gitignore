# F.R.I.D.A.Y. v2 — Git Ignore

# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl

# ── Virtual environments ────────────────────────────────────────
.venv/
venv/
ENV/

# ── IDE ─────────────────────────────────────────────────────────
.idea/
.vscode/
.claude/
*.swp
*.swo
*~

# ── Secrets & credentials (NEVER commit) ────────────────────────
.env
secrets/
*.pem
*.key
token.json
ops/searxng/.env
ops/searxng/valkey/

# ── Audio recordings & references ───────────────────────────────
audio.wav
*.wav
!models/voice_reference.wav
!models/voice_reference_*.wav
!models/**/*.wav

# ── Runtime data ────────────────────────────────────────────────
data/
workspace/
audit_log.jsonl
conversation_history.json

# ── Legacy files (will be removed) ──────────────────────────────
_stale_delete_me/

# ── OS artifacts ────────────────────────────────────────────────
Thumbs.db
.DS_Store

# ── Testing & Type Checking ─────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
htmlcov/

